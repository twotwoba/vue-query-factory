{
    "name": "vue-query-factory",
    "version": "0.0.4",
    "description": "A secondary encapsulation based on @tanstack/vue-query.",
    "keywords": [
        "@tanstack/vue-query",
        "tanstack",
        "vue",
        "vue-query"
    ],
    "license": "MIT",
    "author": "twotwoba",
    "repository": {
        "type": "git",
        "url": "https://github.com/twotwoba/vue-query-factory"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "main": "./dist/vue-query-factory.cjs.js",
    "module": "./dist/vue-query-factory.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/vue-query-factory.es.js",
            "require": "./dist/vue-query-factory.cjs.js"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
        "build:js": "vite build",
        "build:types": "tsc --emitDeclarationOnly --outDir dist",
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:write": "oxfmt --write .",
        "fmt:check": "oxfmt --check",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "pnpm run build",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@tanstack/vue-query": "^5.67.2",
        "@types/node": "^25.9.1",
        "@vitejs/plugin-vue": "^6.0.7",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "oxfmt": "^0.51.0",
        "oxlint": "^1.66.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.14",
        "vitest": "^4.1.7",
        "vue": "^3.5.0"
    },
    "peerDependencies": {
        "@tanstack/vue-query": ">=5.0.0 <6.0.0",
        "vue": ">=3.3.0"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,cjs,vue}": "npm run lint",
        "*": "oxfmt --no-error-on-unmatched-pattern"
    },
    "packageManager": "pnpm@10.33.3"
}
